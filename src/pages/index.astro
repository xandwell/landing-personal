---
import Layout from '../layouts/Layout.astro';

const links = [
  { label: 'GitHub', href: 'https://youtu.be/dQw4w9WgXcQ', icon: 'github' },
  { label: 'LinkedIn', href: 'https://youtu.be/dQw4w9WgXcQ', icon: 'linkedin' },
];
---

<Layout title="Landing">
  <main class="page-shell">
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <img
      class="dvd-logo"
      src="https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExbGdocmRmMHVkdG80NnNoY3dqcWp4cW5kZXpjcmFtbWlvcmpvZXpibyZlcD12MV9naWZzX3JlbGF0ZWQmY3Q9Zw/m5JOLhZsV15j1MtkTE/giphy.gif"
      alt=""
      aria-hidden="true"
    />

    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow"><span class="eyebrow-line"></span> A little corner of the internet</p>
      <h1 id="hero-title">Hi, I’m <span>&lt;?&gt;</span></h1>
      <p class="intro">Short one-line intro.</p>
      <div class="divider" aria-hidden="true"><span></span><span></span><span></span></div>
      <p class="prompt">Find me around the web</p>
      <div class="social-links">
        {links.map((link) => (
          <a class="social-link" href={link.href} target="_blank" rel="noreferrer">
            <span class="social-icon" aria-hidden="true">
              {link.icon === 'github' ? (
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.68-3.75-1.32-3.75-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.62 1.22 3.26.93.1-.72.4-1.22.71-1.5-2.48-.28-5.1-1.24-5.1-5.52 0-1.22.44-2.22 1.16-3-.12-.28-.5-1.42.11-2.96 0 0 .95-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.1-1.43 3.04-1.15 3.04-1.15.61 1.54.23 2.68.12 2.96.72.78 1.15 1.78 1.15 3.01 0 4.28-2.62 5.23-5.12 5.5.4.35.76 1.02.76 2.06v3.07c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V8.98h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.31ZM5.32 7.42a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.03H3.54V8.98H7.1v11.47ZM22.22 0H1.77C.8 0 0 .77 0 1.73v20.54C0 23.23.8 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
              )}
            </span>
            <span>{link.label}</span>
            <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        ))}
      </div>
    </section>

  </main>
</Layout>

<script>
  const logo = document.querySelector<HTMLImageElement>('.dvd-logo');

  if (logo) {
    const startBouncing = () => {
      let x = Math.random() * Math.max(0, window.innerWidth - logo.offsetWidth);
      let y = Math.random() * Math.max(0, window.innerHeight - logo.offsetHeight);
      let vx = (Math.random() < 0.5 ? -1 : 1) * 150;
      let vy = (Math.random() < 0.5 ? -1 : 1) * 115;
      let previousTime = performance.now();

      const animate = (now: number) => {
        const elapsed = Math.min((now - previousTime) / 1000, 0.05);
        previousTime = now;

        const maxX = Math.max(0, window.innerWidth - logo.offsetWidth);
        const maxY = Math.max(0, window.innerHeight - logo.offsetHeight);
        x += vx * elapsed;
        y += vy * elapsed;

        if (x <= 0 || x >= maxX) {
          x = Math.min(maxX, Math.max(0, x));
          vx *= -1;
        }
        if (y <= 0 || y >= maxY) {
          y = Math.min(maxY, Math.max(0, y));
          vy *= -1;
        }

        logo.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        requestAnimationFrame(animate);
      };

      logo.style.visibility = 'visible';
      requestAnimationFrame(animate);
    };

    if (logo.complete && logo.naturalWidth > 0) {
      startBouncing();
    } else {
      logo.addEventListener('load', startBouncing, { once: true });
    }
  }
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #f1f1ba; color: #20231f; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  .page-shell { min-height: 100svh; position: relative; overflow: hidden; display: flex; flex-direction: column; padding: 0 clamp(24px, 7vw, 104px); isolation: isolate; background: radial-gradient(ellipse at 16% 14%, rgba(247,219,59,.94), transparent 38%), radial-gradient(ellipse at 87% 84%, rgba(93,178,87,.88), transparent 42%), linear-gradient(132deg, #f7db3b 0%, #f1f1ba 48%, #5db257 100%); }
  .page-shell::before { content: ''; position: absolute; z-index: -2; inset: 0; background-image: linear-gradient(rgba(31,54,27,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(31,54,27,.045) 1px, transparent 1px); background-size: 56px 56px; mask-image: linear-gradient(to bottom, black, transparent 82%); }
  .ambient { position: absolute; z-index: -1; border-radius: 50%; filter: blur(1px); pointer-events: none; }
  .ambient-one { width: min(45vw, 600px); aspect-ratio: 1; top: -16%; left: -10%; background: radial-gradient(circle, rgba(247,219,59,.7), rgba(247,219,59,0) 70%); }
  .ambient-two { width: min(45vw, 580px); aspect-ratio: 1; right: -13%; bottom: -25%; background: radial-gradient(circle, rgba(93,178,87,.65), rgba(93,178,87,0) 70%); }
  .dvd-logo { position: fixed; z-index: 0; top: 0; left: 0; width: clamp(100px, 16vw, 160px); height: auto; opacity: .6; visibility: hidden; pointer-events: none; user-select: none; will-change: transform; }
  .hero { position: relative; z-index: 1; width: min(100%, 760px); margin: auto; padding: clamp(40px, 7vw, 76px) clamp(24px, 6vw, 64px); border: 1px solid rgba(255,255,255,.58); border-radius: 18px; background: rgba(255,255,240,.68); box-shadow: 0 24px 80px rgba(39,72,34,.12), inset 0 1px 0 rgba(255,255,255,.65); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
  .eyebrow, .prompt { color: #858a7d; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 12px; margin: 0 0 27px; }
  .eyebrow-line { width: 24px; height: 1px; background: #a5ad98; }
  h1 { margin: 0; color: #252923; font-size: clamp(58px, 9.5vw, 112px); font-weight: 540; letter-spacing: -.085em; line-height: .98; }
  h1 span { color: #4b8b48; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-style: italic; letter-spacing: -.09em; }
  .intro { margin: 25px 0 0; color: #555b4c; font-size: clamp(16px, 2vw, 19px); line-height: 1.6; letter-spacing: -.025em; }
  .divider { display: flex; gap: 5px; margin: 55px 0 24px; }
  .divider span { width: 4px; height: 4px; border-radius: 50%; background: #adb5a3; }
  .divider span:first-child { width: 28px; border-radius: 3px; background: #5db257; }
  .prompt { margin: 0 0 15px; font-size: 10px; letter-spacing: .12em; }
  .social-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .social-link { display: inline-flex; min-width: 144px; height: 48px; align-items: center; gap: 11px; padding: 0 15px; border: 1px solid rgba(50,59,45,.14); border-radius: 7px; background: rgba(255,255,252,.58); color: #363b33; text-decoration: none; font-size: 13px; font-weight: 550; transition: transform .2s ease, border-color .2s ease, background .2s ease; }
  .social-link:hover { transform: translateY(-2px); border-color: rgba(74,91,64,.38); background: #fff; }
  .social-icon { display: grid; width: 17px; height: 17px; place-items: center; }
  .social-icon svg { display: block; width: 17px; height: 17px; }
  .arrow { width: 13px; height: 13px; margin-left: auto; color: #969d8d; transition: transform .2s ease; }
  .social-link:hover .arrow { transform: translate(2px,-2px); }
  @media (max-width: 600px) { .dvd-logo { width: 112px; } .hero { padding: 48px 24px; } .divider { margin-top: 43px; } .social-link { flex: 1 1 140px; } }
  @media (prefers-reduced-motion: reduce) { .social-link, .arrow { transition: none; } }
</style>
